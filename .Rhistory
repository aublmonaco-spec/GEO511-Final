rth_inat <- read.csv("data/rth_nat.csv")
rth_inat <- rth_inat %>%
rename(Latitude = latitude, Longitude = longitude) %>% # Renaming for joining
filter(captive_cultivated == "false" & quality_grade == "research") # Filtered to ensure I had verified data and wild sightings
rth_some <- rth_ebird %>% full_join(rth_inat, relationship = "many-to-many")
rth_more <- rth_some %>% full_join(jn_table)
rth_most <- rth_some %>% full_join(rth_more, relationship = "many-to-many")
all_rth <- rth_most %>% full_join(npn_rth)
