mutate(mean1014 = case_when(latitude >= 28.03844 & latitude < 33 ~ 256.5172
,
latitude > 33 & latitude < 36 ~ 238.0811,
latitude > 36 & latitude < 39 ~ 231.8,
latitude > 39 & latitude < 42 ~ 225.4737,
latitude > 42 & latitude < 47.67724 ~ 226.3913)) %>%
mutate(mean_early = as.numeric(mean1014))
cardinal_flower <- cardinal_flower %>% full_join(cardinal_flower_early)
