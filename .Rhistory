library(doParallel)
library(foreach)
library(plotly)
library(leaflet)
library(leaflet.providers)
library(leaflet.extras)
library(rinat)
library(rnpn)
library(rvest) # Used to download data from Journey North
library(dplyr) # Mutating and filtering data
library(lubridate) # Parsing date data
library(ggplot2) # Plotting trends
num_cores <- parallel::detectCores() - 1
registerDoParallel(num_cores)
nat_flower <- read.csv("data/fl_all.csv")
npn_flower <- read.csv("data/npn_flower.csv")
all_flower <- nat_flower %>% full_join(npn_flower)
all_flower <- all_flower %>%
mutate(year = year(observed_on)) %>% # Pulls year from date
mutate(year_day = yday(observed_on)) %>% # Puts date into day out of 365
mutate(month = month(observed_on)) # Pulls month from date
fl_early <- all_flower %>%
filter(year %in% c(2005, 2006, 2007, 2008, 2009, 2010, 2011, 2012, 2013) & month %in% c(3, 4, 5))
fl_early_30 <- fl_early %>%
filter(latitude > 30 & latitude < 36) %>%
mutate(mean = mean(year_day, na.rm = TRUE))
fl_early_36 <- fl_early %>%
filter(latitude > 36 & latitude < 42) %>%
mutate(mean = mean(year_day, na.rm = TRUE))
fl_early_42 <- fl_early %>%
filter(latitude > 42 & latitude < 48) %>%
mutate(mean = mean(year_day, na.rm = TRUE))
fl_early_all <- rbind(fl_early_30, fl_early_36, fl_early_42)
#Checked each dataset for the mean bloom date
fl_new <- all_flower %>%
filter(year %in% c(2014, 2015, 2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025) & month %in% c(3, 4, 5)) %>%
mutate(mean0013 =
case_when(
latitude > 30 & latitude < 33 ~ 91.5931,
latitude > 33 & latitude < 36 ~ 91.5931,
latitude > 36 & latitude < 39 ~ 123.9448,
latitude > 39 & latitude < 42 ~ 123.9448,
latitude > 42 & latitude < 45 ~ 133.5402,
latitude > 45 & latitude < 48 ~ 133.5402))
fl_30 <- fl_new %>%
filter(latitude > 30 & latitude < 33) %>%
mutate(mean = mean(year_day, na.rm = TRUE)) %>%
mutate(difference = mean - mean0013)
fl_33 <- fl_new %>%
filter(latitude > 33 & latitude < 36) %>%
mutate(mean = mean(year_day, na.rm = TRUE)) %>%
mutate(difference = mean - mean0013)
fl_36 <- fl_new %>%
filter(latitude > 36 & latitude < 39) %>%
mutate(mean = mean(year_day, na.rm = TRUE)) %>%
mutate(difference = mean - mean0013)
fl_39 <- fl_new %>%
filter(latitude > 39 & latitude < 42) %>%
mutate(mean = mean(year_day, na.rm = TRUE)) %>%
mutate(difference = mean - mean0013)
fl_42 <- fl_new %>%
filter(latitude > 42 & latitude < 45) %>%
mutate(mean = mean(year_day, na.rm = TRUE)) %>%
mutate(difference = mean - mean0013)
fl_45 <- fl_new %>%
filter(latitude > 45 & latitude < 48) %>%
mutate(mean = mean(year_day, na.rm = TRUE)) %>%
mutate(difference = mean - mean0013)
fl_new_all <- rbind(fl_30, fl_33, fl_36, fl_39, fl_42, fl_45)
View(fl_new_all)
