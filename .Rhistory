selected_fl <- fl_means[c(1, 25, 68), ]
# Converting yearday into date
origin_date <- as.Date(paste0(2013, "-01-01"))
fl_early_date1 <- as.Date(82 - 1, origin = origin_date)
fl_early_date2 <- as.Date(98 - 1, origin = origin_date)
fl_early_date3 <- as.Date(108 - 1, origin = origin_date)
fl_early_dates <- c(fl_early_date1, fl_early_date2, fl_early_date3)
fl_early_dates <- format(fl_early_dates, format = "%B %d")
selected_fl <- cbind(selected_fl, fl_early_dates)
selected_fl <- selected_fl %>%
rename("Flowering Date" = "...3")
# Table to show early period flowering times based on latitude bands
kable(selected_fl, format = "pipe", caption = '<span style="color: darkred;">2005-2013 Flowering Time Means (days)</span>')
