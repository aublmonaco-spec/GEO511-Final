Sys.sleep(1)
}
library(doParallel)
num_cores <- parallel::detectCores() - 1
registerDoParallel(num_cores)
jn_table <- foreach(url = jn_urls, .packages = "rvest", .combine = rbind) %dopar% {
lapply(jn_urls, read_html)
Sys.sleep(1)
}
