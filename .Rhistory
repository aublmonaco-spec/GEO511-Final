cardinal_flower <- read.csv("data/cf_all.csv")
# Chunk 3
cardinal_flower <- cardinal_flower %>%
mutate(observed_on_string = as.Date(observed_on_string)) %>%
mutate(year = year(observed_on_string)) %>%
mutate(year_day = yday(observed_on_string)) %>%
mutate(month = month(observed_on_string))
# Chunk 4
cf_early <- cardinal_flower %>%
filter(year %in% c(2010, 2011, 2012, 2013, 2014) & month %in% c(6, 7, 8, 9))
cf_early_27 <- cf_early %>%
filter(latitude >= 28.13680 & latitude < 33) %>%
mutate(mean27 = mean(year_day, na.rm = TRUE))
cf_early_33 <- cf_early %>%
filter(latitude > 33 & latitude < 36) %>%
mutate(mean33 = mean(year_day, na.rm = TRUE))
cf_early_36 <- cf_early %>%
filter(latitude > 36 & latitude < 39) %>%
mutate(mean36 = mean(year_day, na.rm = TRUE))
cf_early_39 <- cf_early %>%
filter(latitude > 39 & latitude <= 42) %>%
mutate(mean39 = mean(year_day, na.rm = TRUE))
cf_early_42 <- cf_early %>%
filter(latitude > 42 & latitude <= 47.67724) %>%
mutate(mean42 = mean(year_day, na.rm = TRUE))
cfearly1 <- cf_early_27 %>% full_join(cf_early_33)
cfearly2 <- cf_early_36 %>% full_join(cf_early_39)
cfearly3 <- cfearly2 %>% full_join(cf_early_42)
cardinal_flower_early <- cfearly3 %>% full_join(cfearly1)
