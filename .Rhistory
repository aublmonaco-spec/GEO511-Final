filter(Latitude >= 27 & Latitude < 30) %>%
mutate(mean = mean(year_day, na.rm = TRUE))
rthearly30 <- rth_early %>%
filter(Latitude > 30 & Latitude < 33) %>%
mutate(mean = mean(year_day, na.rm = TRUE))
rthearly33 <- rth_early %>%
filter(Latitude >= 33 & Latitude < 36) %>%
mutate(mean = mean(year_day, na.rm = TRUE))
rthearly36 <- rth_early %>%
filter(Latitude > 36 & Latitude < 39) %>%
mutate(mean = mean(year_day, na.rm = TRUE))
rthearly39 <- rth_early %>%
filter(Latitude >= 39 & Latitude < 42) %>%
mutate(mean = mean(year_day, na.rm = TRUE))
rthearly42 <- rth_early %>%
filter(Latitude > 42 & Latitude < 45.28700) %>%
mutate(mean = mean(year_day, na.rm = TRUE))
rthearly1 <- rthearly24 %>% full_join(rthearly27)
rthearly2 <- rthearly30 %>% full_join(rthearly33)
rthearly3 <- rthearly36 %>% full_join(rthearly39)
rthearly4 <- rthearly3 %>% full_join(rthearly42)
rthearly5 <- rthearly1 %>% full_join(rthearly2)
rthearly <- rthearly4 %>% full_join(rthearly4)
ruby_throat_all <- ruby_throat %>% full_join(rth_early)
rpal <- colorNumeric(palette = "mako", domain = rubythroat_all$mean, na.color = NA)
leaflet(rubythroat_all) %>%
addProviderTiles(provider = "Esri") %>%
addSimpleGraticule(interval = 3) %>%
addCircleMarkers(~Longitude, ~ Latitude, radius = 1, color = ~rpal(difference)) %>%
addLegend(pal = rpal, values = ~difference, title = "Difference From 2010-2014 Average (days)", position = "bottomleft")
View(rubythroat_all)
leaflet(rubythroat_all) %>%
addProviderTiles(provider = "Esri") %>%
addSimpleGraticule(interval = 3) %>%
addCircleMarkers(~Longitude, ~ Latitude, radius = 1, color = ~rpal(mean)) %>%
addLegend(pal = rpal, values = ~mean, title = "Difference From 2010-2014 Average (days)", position = "bottomleft")
leaflet(rubythroat_all) %>%
addProviderTiles(provider = "Esri") %>%
addSimpleGraticule(interval = 3) %>%
addCircleMarkers(~Longitude, ~ Latitude, radius = 1, color = ~rpal(mean)) %>%
addLegend(pal = rpal, values = ~mean, title = "Average Day of Arrival (Year Day)", position = "bottomleft")
rearlypal <- colorNumeric(palette = "mako", domain = rthearly$mean)
leaflet(rthearly) %>%
addProviderTiles(provider = "Esri") %>%
addSimpleGraticule(interval = 3) %>%
addCircleMarkers(~Longitude, ~ Latitude, radius = 1, color = ~rearlypal(mean)) %>%
addLegend(pal = rearlypal, values = ~mean, title = "Average Day of Arrival (Year Day)", position = "bottomleft")
