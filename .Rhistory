lapply(jn_urls, read_html)
Sys.sleep(1)
}
jn_table <- foreach(url = jn_urls, .packages = "rvest", .combine = rbind) %do% {
jn_table <- lapply(jn_urls, read_html) %>%
html_elements("table") %>%
html_table()
Sys.sleep(1)
}
