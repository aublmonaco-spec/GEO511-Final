#npn_download_individual_phenometrics(
# request_source='Aubrey Monaco',
# years=c(2010,2011,2012,2013,2014,2015,2016,2017,2018,2019,2020,2021,2022,2023,2024, 2025),
#species_id=c(352),
# download_path="data/npn_rth.csv")
npn_rth <- read.csv("data/npn_rth.csv")
npn_rth <- npn_rth %>%
rename(Latitude = latitude)
rth_1014 <- read.csv("data/RTH_1995_2021.csv")
rth_1525 <- read.csv("data/RTH_2022_2025.csv")
rth_ebird <- rth_1014 %>% full_join(rth_1525)
rth_inat <- read.csv("data/rth_nat.csv")
rth_inat <- rth_inat %>%
rename(Latitude = latitude) %>%
filter(captive_cultivated == "false" & quality_grade == "research")
rth_some <- rth_ebird %>% full_join(rth_inat)
rth_all <- rth_some %>% full_join(npn_rth)
ruby_throat <- rth_all %>%
mutate(date_new = parse_date_time(Date, orders = c("mdy", "ydm", "dmy"))) %>%
mutate(year_new = year(date_new)) %>%
mutate(year_day = yday(date_new))
rth_early <- ruby_throat %>%
filter(Year %in% c(2010, 2011, 2012, 2013, 2014, 2015, 2016, 2017) & Month %in% c(2, 3, 4, 5))
rthearly24 <- rth_early %>%
filter(Latitude >= 24.62760 & Latitude < 27) %>%
mutate(mean = mean(year_day, na.rm = TRUE))
rthearly27 <- rth_early %>%
filter(Latitude >= 27 & Latitude < 30) %>%
mutate(mean = mean(year_day, na.rm = TRUE))
rthearly30 <- rth_early %>%
filter(Latitude > 30 & Latitude < 33) %>%
mutate(mean = mean(year_day, na.rm = TRUE))
rthearly33 <- rth_early %>%
filter(Latitude >= 33 & Latitude < 36) %>%
mutate(mean = mean(year_day, na.rm = TRUE))
rthearly36 <- rth_early %>%
filter(Latitude > 36 & Latitude < 39) %>%
mutate(mean = mean(year_day, na.rm = TRUE))
rthearly39 <- rth_early %>%
filter(Latitude >= 39 & Latitude < 42) %>%
mutate(mean = mean(year_day, na.rm = TRUE))
rthearly42 <- rth_early %>%
filter(Latitude > 42 & Latitude < 45.28700) %>%
mutate(mean = mean(year_day, na.rm = TRUE))
rthearly1 <- rthearly24 %>% full_join(rthearly27)
rthearly2 <- rthearly30 %>% full_join(rthearly33)
rthearly3 <- rthearly36 %>% full_join(rthearly39)
rthearly4 <- rthearly3 %>% full_join(rthearly42)
rthearly5 <- rthearly1 %>% full_join(rthearly2)
rthearly <- rthearly4 %>% full_join(rthearly4)
ruby_throat_all <- ruby_throat %>% full_join(rth_early)
# Chunk 7
rth_all <- ruby_throat_all %>%
filter(Year %in% c(2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025) & Month %in% c(2, 3, 4, 5)) %>%
mutate(mean1017 = case_when(Latitude >= 24.54630 & Latitude < 27 ~ 110.2414,
Latitude > 27 & Latitude < 30 ~ 112.7043,
Latitude > 30 & Latitude < 33 ~ 99.69231,
Latitude > 33 & Latitude < 36 ~ 104.48,
Latitude > 36 & Latitude < 39 ~ 125.4231,
Latitude > 39 & Latitude < 42 ~ 132.783,
Latitude > 42 & Latitude <= 48.08812 ~ 136.4409
))
rth_24 <- rth_all %>%
filter(Latitude >= 24.54630 & Latitude < 27) %>%
mutate(mean = mean(year_day, na.rm = TRUE)) %>%
mutate(difference = mean - mean1017)
rth_27 <- rth_all %>%
filter(Latitude > 27 & Latitude < 36) %>%
mutate(mean = mean(year_day, na.rm = TRUE)) %>%
mutate(difference = mean - mean1017)
rth_30 <- rth_all %>%
filter(Latitude > 30 & Latitude < 36) %>%
mutate(mean = mean(year_day, na.rm = TRUE)) %>%
mutate(difference = mean - mean1017)
rth_33 <- rth_all %>%
filter(Latitude > 33 & Latitude < 36) %>%
mutate(mean = mean(year_day, na.rm = TRUE)) %>%
mutate(difference = mean - mean1017)
rth_36 <- rth_all %>%
filter(Latitude > 36 & Latitude < 39) %>%
mutate(mean = mean(year_day, na.rm = TRUE)) %>%
mutate(difference = mean - mean1017)
rth_39 <- rth_all %>%
filter(Latitude > 39 & Latitude < 42) %>%
mutate(mean = mean(year_day, na.rm = TRUE)) %>%
mutate(difference = mean - mean1017)
rth_42 <- rth_all %>%
filter(Latitude > 42 & Latitude < 45) %>%
mutate(mean = mean(year_day, na.rm = TRUE)) %>%
mutate(difference = mean - mean1017)
rth_1 <- rth_24 %>% full_join(rth_27)
rth_2 <- rth_30 %>% full_join(rth_33)
rth_3 <- rth_36 %>% full_join(rth_39)
rth_4 <- rth_3 %>% full_join(rth_42)
rth_5 <- rth_1 %>% full_join(rth_2)
rubythroat_all <- rth_4 %>% full_join(rth_5)
# Chunk 8
cpal <- colorNumeric(palette = "inferno", domain = fl_all$difference, na.color = NA)
rpal <- colorNumeric(palette = "mako", domain = rubythroat_all$difference, na.color = NA)
# Chunk 9
leaflet(fl_all) %>%
addProviderTiles(provider = "Esri") %>%
addSimpleGraticule(interval = 3) %>%
addCircleMarkers(~longitude, ~ latitude, radius = 1, color = ~cpal(difference)) %>%
addLegend(pal = cpal, values = ~difference, title = "Difference From 2010-2017 Average (days)", position = "bottomleft")
# Chunk 10
leaflet(rubythroat_all) %>%
addProviderTiles(provider = "Esri") %>%
addSimpleGraticule(interval = 3) %>%
addCircleMarkers(~Longitude, ~ Latitude, radius = 1, color = ~rpal(difference)) %>%
addLegend(pal = rpal, values = ~difference, title = "Difference From 2010-2017 Average (days)", position = "bottomleft")
cpal <- colorNumeric(palette = "rocket", domain = fl_all$difference, na.color = NA)
leaflet(fl_all) %>%
addProviderTiles(provider = "Esri") %>%
addSimpleGraticule(interval = 3) %>%
addCircleMarkers(~longitude, ~ latitude, radius = 1, color = ~cpal(difference)) %>%
addLegend(pal = cpal, values = ~difference, title = "Difference From 2010-2017 Average (days)", position = "bottomleft")
cpal <- colorNumeric(palette = "mako", domain = fl_all$difference, na.color = NA)
