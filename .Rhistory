kable(selected_rth, format = "pipe", caption = '<span style="color: darkblue;">2005-2013 Ruby-throat Arrival Means</span>', align = "c")
# Chunk 18
#| code-fold: TRUE
rth_new <- all_rth %>%
filter(Year %in% c(2014, 2015, 2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025) & Month %in% c(2,3,4,5)) %>%
mutate(mean0513 =
case_when(latitude > 30 & latitude < 33 ~ 79.80628,
latitude > 33 & latitude < 36 ~ 93.53428,
latitude > 36 & latitude < 39 ~ 105.52074,
latitude > 39 & latitude < 42 ~ 117.30150,
latitude > 42 & latitude < 45 ~ 124.95684,
latitude > 45 & latitude < 48 ~ 129.7148                 ))
rth_new_all <- rth_new %>%
mutate(latbin=cut(latitude, c(30,33,36,39,42,45,48), labels = c("30-33", "33-36", "36-39", "39-42", "42-45", "45-48"))) %>%
group_by(latbin) %>%
mutate(mean = mean(year_day, na.rm=TRUE)) %>%
mutate(difference = mean-mean0513) %>%
drop_na(difference)
rth_new_difference <- rth_new_all %>%
group_by(difference) %>%
select(latbin, difference) %>%
rename("Latitude" = "latbin", "Difference in Ruby-throat Arrival Dates" = "difference")
origin_date2 <- as.Date(paste0(2025, "-01-01"))
rth_new_date1 <- as.Date(85 - 1, origin = origin_date2)
rth_new_date2 <- as.Date(95 - 1, origin = origin_date2)
rth_new_date3 <- as.Date(106 - 1, origin = origin_date2)
rth_new_date4 <- as.Date(116 - 1, origin = origin_date2)
rth_new_date5 <- as.Date(123 - 1, origin = origin_date2)
rth_new_date6 <- as.Date(127 - 1, origin = origin_date2)
rth_new_dates <- c(rth_new_date1, rth_new_date2, rth_new_date3, rth_new_date4, rth_new_date5, rth_new_date6)
rth_new_dates <- format(rth_new_dates, format = "%B %d")
# One row for each latitude band difference selected
rth_new_difference <- rth_new_difference[c(1, 14105, 13263, 8261, 24450, 92), ]
rth_new_difference <- cbind(rth_new_difference, rth_new_dates)
rth_new_difference <- rth_new_difference %>%
rename("Arrival Date" = "...3")
# Chunk 19
#| code-fold: TRUE
# Mapping colors to "difference" columns
cpal <- colorNumeric(palette = "viridis", domain = fl_new_all$difference, na.color = NA)
rpal <- colorNumeric(palette = "viridis", domain = rth_new_all$difference, na.color = NA)
